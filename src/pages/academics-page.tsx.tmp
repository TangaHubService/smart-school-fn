
function TermsDrawer({
  yearId,
  yearName,
  terms,
  onClose,
  onEdit,
  onDelete,
  onAddTerm,
  toDateInput,
}: {
  yearId: string;
  yearName: string;
  terms: Term[];
  onClose: () => void;
  onEdit: (term: Term) => void;
  onDelete: (term: Term) => void;
  toDateInput: (value: string | Date) => string;
  onAddTerm?: () => void;
}) {
  return (
    <AppDrawer
      open
      onClose={onClose}
      title={`Terms — ${yearName}`}
      description="List of terms for this academic year."
    >
      {onAddTerm ? (
        <div className="mb-2">
          <button type="button" onClick={onAddTerm} className="rounded-lg bg-brand-500 px-3 py-2 text-xs font-semibold text-white">
            Add Term
          </button>
        </div>
      ) : null}

      {terms.length === 0 ? (
        <p className="py-8 text-center text-sm text-slate-500">No terms found for this academic year.</p>
      ) : (
        <div className="divide-y divide-slate-100">
          {terms.map((term) => (
            <div key={term.id} className="flex items-center justify-between gap-4 py-3">
              <div className="min-w-0">
                <p className="text-sm font-semibold text-slate-900">{term.name}</p>
                <p className="text-xs text-slate-500">
                  {toDateInput(term.startDate)} — {toDateInput(term.endDate)}
                </p>
              </div>
              <div className="flex shrink-0 gap-2">
                <button
                  type="button"
                  onClick={() => onEdit(term)}
                  className="rounded-md border border-brand-200 bg-brand-50 px-2 py-1 text-xs font-semibold text-slate-700">
                  Edit
                </button>
                <button
                  type="button"
                  onClick={() => onDelete(term)}
                  className="rounded-md border border-red-200 bg-red-50 px-2 py-1 text-xs font-semibold text-red-700">
                  Delete
                </button>
              </div>
            </div>
          ))}
        </div>
      )}
    </AppDrawer>
  );
}

